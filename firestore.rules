rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function validUserProfile() {
      return request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'grade', 'city', 'locale', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'email', 'photoURL', 'grade', 'city', 'locale', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.grade is string
        && request.resource.data.grade.size() <= 60
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.locale in ['kk', 'ru', 'en']
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && validUserProfile()
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && validUserProfile()
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn() && request.auth.uid == uid;

      // Learning progress per material. Mirrors MaterialProgress in src/lib/progress.ts.
      match /progress/{materialSlug} {
        allow get, list: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update: if signedIn() && request.auth.uid == uid && validProgress(materialSlug);
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // XP ledger: one immutable entry per rewarded action, so XP cannot be granted twice.
      match /xp/{entryId} {
        allow get, list: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid && validXp(entryId);
        allow update, delete: if false;
      }
    }

    function validProgress(materialSlug) {
      let d = request.resource.data;
      return d.keys().hasOnly(['materialSlug', 'status', 'positionSeconds', 'durationSeconds', 'watched', 'assessmentScore', 'assessmentPassed', 'updatedAt'])
        && d.keys().hasAll(['materialSlug', 'status', 'positionSeconds', 'durationSeconds', 'watched', 'assessmentScore', 'assessmentPassed', 'updatedAt'])
        && d.materialSlug == materialSlug
        && d.status in ['not_started', 'in_progress', 'completed']
        && d.positionSeconds is int && d.positionSeconds >= 0 && d.positionSeconds <= 86400
        && d.durationSeconds is int && d.durationSeconds >= 0 && d.durationSeconds <= 86400
        && d.watched is bool
        && d.assessmentScore is int && d.assessmentScore >= -1 && d.assessmentScore <= 100
        && d.assessmentPassed is bool
        && d.updatedAt == request.time;
    }

    function validXp(entryId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['amount', 'reason', 'materialSlug', 'createdAt'])
        && d.keys().hasAll(['amount', 'reason', 'materialSlug', 'createdAt'])
        && d.amount is int && d.amount >= 0 && d.amount <= 1000
        && d.reason == 'assessment'
        && entryId == 'assessment-' + d.materialSlug
        && d.createdAt == request.time;
    }

    function validPublication(resourceId) {
      return request.resource.data.publicationStatus in ['draft', 'published']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 180
        && request.resource.data.slug == resourceId;
    }

    match /contentMeta/{collectionName} {
      allow get: if collectionName in ['materials', 'events'];
      allow list: if false;
      allow create, update: if isAdmin()
        && collectionName in ['materials', 'events']
        && request.resource.data.initialized == true;
      allow delete: if isAdmin() && collectionName in ['materials', 'events'];
    }

    match /materials/{resourceId} {
      allow get: if isAdmin() || resource.data.publicationStatus == 'published';
      allow list: if isAdmin() || resource.data.publicationStatus == 'published';
      allow create: if isAdmin() && request.resource.data.publicationStatus in ['draft', 'published']
        && request.resource.data.title is string && request.resource.data.title.size() <= 180
        && request.resource.data.slug == resourceId;
      allow update: if isAdmin() && validPublication(resourceId);
      allow delete: if isAdmin();
    }

    match /events/{resourceId} {
      allow get: if isAdmin() || resource.data.publicationStatus == 'published';
      allow list: if isAdmin() || resource.data.publicationStatus == 'published';
      allow create: if isAdmin() && request.resource.data.publicationStatus in ['draft', 'published']
        && request.resource.data.title is string && request.resource.data.title.size() <= 180
        && request.resource.data.slug == resourceId;
      allow update: if isAdmin() && validPublication(resourceId);
      allow delete: if isAdmin();
    }

    // Product applications and event registrations. Anyone may submit; only admins read or triage.
    // Field limits mirror LEAD_LIMITS in src/lib/leads.ts.
    function validLead() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'targetSlug', 'targetTitle', 'name', 'phone', 'email', 'note', 'locale', 'uid', 'status', 'createdAt'])
        && d.keys().hasAll(['kind', 'targetSlug', 'targetTitle', 'name', 'phone', 'email', 'note', 'locale', 'uid', 'status', 'createdAt'])
        && d.kind in ['product', 'event']
        && d.targetSlug is string && d.targetSlug.size() > 0 && d.targetSlug.size() <= 120
        && d.targetTitle is string && d.targetTitle.size() <= 200
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 40
        && d.email is string && d.email.size() <= 200
        && d.note is string && d.note.size() <= 1000
        && d.locale in ['kk', 'ru', 'en']
        && (d.uid == '' || (signedIn() && d.uid == request.auth.uid))
        && d.status == 'new'
        && d.createdAt == request.time;
    }

    match /leads/{leadId} {
      allow create: if validLead();
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'contacted', 'closed'];
      allow delete: if isAdmin();
    }

    // Deny all other collections until their access model is explicitly designed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
